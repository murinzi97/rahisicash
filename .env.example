# Copy this file to .env and fill in the two values from
# Supabase -> Project Settings -> API.
# Use the PUBLISHABLE (anon) key ONLY. NEVER put the service role / secret
# key in this app: anything in here is visible to every visitor.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
